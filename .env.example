# ==============================================================================
# SHUBH DIWALI DHAMAKA - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0

# Security Secret Key (Used for secure admin session signing)
# Replace with a strong random 64-character hex string in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes_min

# Admin Credentials
# Set a strong password for administrative access. Insecure defaults will be rejected.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ShubhDiwali@Admin2026!Secure

# Rate Limiting & Protection
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
MAX_REQUEST_BODY_BYTES=65536

# ==============================================================================
# LEGAL AND PRODUCT SAFETY GATE FLAGS (DEFAULT: FALSE)
# WARNING: Do not enable these flags until written legal clearance is obtained
# from qualified Indian advocates regarding lottery, gaming, and PESO regulations.
# ==============================================================================
ENABLE_REAL_PAYMENTS=false
ENABLE_PAID_ENTRIES=false
ENABLE_PUBLIC_DRAWS=false
ENABLE_PRIZE_CLAIMS=false
ENABLE_PHYSICAL_SHIPMENT=false

# Payment Gateway Keys (Only used when ENABLE_REAL_PAYMENTS=true)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPI_MERCHANT_VPA=
UPI_MERCHANT_NAME=
